# Это файл .gitignore для проектов Unreal Engine
# Должен размещаться в корневой директории проекта

# Intermediate файлы и папки сборки
/Intermediate/
/Binaries/
/Build/
/Saved/
/DerivedDataCache/

# Конфигурационные файлы IDE
.vs/
.vscode/
/.idea/
*.sln
*.suo
*.sdf
*.opensdf
*.vcxproj
*.vcxproj.filters
*.vcxproj.user
*.xcodeproj/
*.xcworkspace/

# Логи и временные файлы
/*.log
/*.tmp
/*.temp

# Сгенерированные файлы
/Content/*.uexp
/Content/*.ubulk
/Content/*.uptnl

# Настройки проекта (кроме DefaultEngine.ini)
/Config/Local/
/Config/UE4Editor*.ini
/Config/UE5Editor*.ini
/Config/User*.ini

# Платформозависимые бинарные файлы
/*.pdb
/*.ilk
/*.exp
/*.lib
/*.dll
/*.exe

# Пакетные сборки
/Intermediate/Android/
/Intermediate/IOS/
/Intermediate/PS4/
/Intermediate/XboxOne/
/Intermediate/Switch/

# Файлы пользовательских настроек
*.user
*.userprefs

# Файлы автоматического сохранения
/Autosaves/

# Файлы краш-репортов
/CrashReportClient/
/CrashReportClientUE4/
/CrashReportClientUE5/

# Файлы бэкапов
*.bak
*.backup

# Временные файлы, создаваемые при копировании/перемещении
Thumbs.db
.DS_Store
*.swp
*.swo

# Файлы метаданных (если вы используете Git LFS)
# !.uasset.meta
# !.umap.meta

# Исключения для файлов, которые нужно отслеживать через Git LFS
*.uasset filter=lfs diff=lfs merge=lfs -text
*.umap filter=lfs diff=lfs merge=lfs -text
*.upackage filter=lfs diff=lfs merge=lfs -text

# Плагины (исключаем скомпилированные, но сохраняем исходники)
/Plugins/*/Binaries/
/Plugins/*/Intermediate/